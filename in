    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mina Connect | 若者の熱意を、社会の資産へ</title>
    <style>
        body { font-family: "Helvetica Neue", Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; background: #fff; }
        .hero { padding: 100px 20px; text-align: center; background: #f8fafc; }
