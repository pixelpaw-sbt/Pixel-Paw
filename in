        .card { border: 1px solid #eee; padding: 30px; border-radius: 8px; }
        .flow-step { display: flex; align-items: center; margin-bottom: 20px; padding: 20px; background: #f9f9f9; border-radius: 8px; }
        .step-num { font-size: 2rem; font-weight: bold; margin-right: 20px; color: #000; }
